{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proofdown Table Rows: data_quality",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {"type": "string"},
          "dataset": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "warn", "skipped"]},
          "metric": {"type": ["number", "string", "null"]}
        },
        "required": ["check", "dataset", "status"],
        "additionalProperties": true
      }
    }
  },
  "required": ["rows"],
  "additionalProperties": false
}
